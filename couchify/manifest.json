{
  "manifest_version": 3,
  "name": "Couchify",
  "version": "0.1.0",
  "description": "Watch Netflix, HBO Max, YouTube and more in sync with friends across browsers. Rooms, drift correction, region-mismatch alerts.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Couchify"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/worker.js",
    "scripts": ["lib/compat.js", "background/worker.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.play.max.com/*",
        "*://*.max.com/*",
        "*://*.youtube.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://localhost/*",
        "file:///*"
      ],
      "js": ["content/video.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "couchify@dubujordan.fr",
      "strict_min_version": "113.0"
    }
  }
}